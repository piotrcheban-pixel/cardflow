    {
      "front": "От чего зависит давление газа?",
      "back": "Давление газа пропорционально концентрации молекул и температуре.",
      "unit_id": "ku:doc:material.txt#1#0",
      "tags": [
        "давление газа",
        "МКТ"
      ]
    },
    {
      "front": "Какая величина пропорциональна концентрации молекул и температуре газа?",
      "back": "Давление газа.",
      "unit_id": "ku:doc:material.txt#1#0",
      "angle": "reverse",
      "tags": [
        "давление газа",
        "МКТ"
      ]
    },
    {
      "front": "От чего зависит средняя кинетическая энергия молекулы?",
      "back": "Только от температуры.",
      "unit_id": "ku:doc:material.txt#1#1",
      "tags": [
        "кинетическая энергия молекулы",
        "температура"
      ]
    },
    {
      "front": "Какие величины связывает уравнение состояния газа?",
